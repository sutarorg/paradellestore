# Canonical, non-secret. Preview and Production MUST have separate database and payment projects.
SITE_ORIGIN=https://paradelle.store
# Supavisor TRANSACTION pooler URL (port 6543), TLS verified. Dedicated NOINHERIT login,
# granted ONLY paradelle_runtime, NOT postgres. Never prefix this, passwords or keys with NEXT_PUBLIC.
DATABASE_URL=
# Public project configuration. Use the anon/publishable key, never service_role here.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only: Storage and Auth admin revocation, never a substitute for staff profile checks.
SUPABASE_SERVICE_ROLE_KEY=
# Random, independent, >=32 bytes each. Set through Vercel sensitive environment settings.
APP_HMAC_SECRET=
CRON_SECRET=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Optional old signing secret during a bounded webhook rotation; remove after retries finish.
RAZORPAY_WEBHOOK_PREVIOUS_SECRET=
CHECKOUT_ENABLED=false
FAL_KEY=
# Maximum new content + image tasks in a rolling 24h. Five image tasks per initial set.
# Set only after agreeing a spend ceiling; also limit provider balance and concurrency in fal.
FAL_DAILY_SUBMISSION_LIMIT=
# Optional non-secret tag IDs (not API secrets); no tracking without separate consent.
GA4_MEASUREMENT_ID=
META_PIXEL_ID=
# Historical Stage 1/2 adapter/contract tests ONLY. Leave blank in the integrated deployment.
STOREFRONT_API_URL=
PARADELLE_ADMIN_API_URL=
PRODUCT_IMAGE_HOST=
RAZORPAY_ENV=test
# Live keys also require VERCEL_ENV=production and explicit operator approval after signed acceptance.
LIVE_PAYMENTS_APPROVED=false
# Optional trusted CA (PEM, escaped newlines allowed); do not disable certificate checks.
DATABASE_CA_PEM=
