# Optional server-only URL of the public storefront API (including its version prefix).
STOREFRONT_API_URL=
# Exact HTTPS media hostname allowed by next/image, without scheme or path.
PRODUCT_IMAGE_HOST=
# Production canonical origin. Set explicitly when deploying a separate storefront.
SITE_ORIGIN=https://paradelle.store
# Optional, server-only trust boundary for Stage 3 private services in the same application.
# Leave unset for the empty Stage 2 workspace. Never use a public env var for this setting.
PARADELLE_ADMIN_API_URL=
